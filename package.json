{
  "name": "dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx server.ts",
    "dev:web": "vite",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.mjs",
    "build": "tsc -b && vite build",
    "start": "node --env-file-if-exists=.env --import tsx server.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "lint": "tsc -b --pretty",
    "test": "vitest run",
    "llm:test": "node scripts/test-llm-connection.js",
    "verify-data": "node scripts/verify-data.js",
    "test-apis": "node scripts/test-apis.js",
    "test-nordpool": "node scripts/test-nordpool.js"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.67",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
