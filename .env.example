# Northwatch Dashboard Configuration

# Trafikverket API Token (for road traffic data)
TRAFIKVERKET_API_TOKEN=

# ENTSO-E API Token (for energy data)
ENTSOE_API_TOKEN=

# NASA FIRMS API Key
NASA_FIRMS_API_KEY=

# Datacenter World API Key
DATACENTER_WORLD_API_KEY=

# Newsapi.org API Key
NEWSAPI_API_KEY=

# GIE AGSI API Key
GIE_AGGI_API_KEY=

# NIST API Key (as UUID)
NIST_API_KEY=

# OpenAI API Key (for AI services)
OPENAI_API_KEY=

# Google API Key (for Google services)
GOOGLE_API_KEY=

# AISstream API Key
AISSTREAM_API_KEY=

# Nord Pool API Token (for market data)
NORDPOOL_API_TOKEN=

# For development/testing, you can set a dummy token to avoid errors
# ENTSO_E_API_TOKEN=dummy-token-for-testing

# Other configuration options:
# API_PORT=3001
# API_HOST=127.0.0.1

# Enable debug mode for more detailed logging
# NODE_ENV=development